# Copy this file to .env and fill in the values.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/student-management-app

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# How long a login stays valid (e.g. 8h, 1d, 7d)
JWT_EXPIRES_IN=1d

PORT=3000

# Set to "demo" to create the demo college (accounts for every role, password Demo@123)
# automatically when the server starts. Safe to leave on: it only runs once.
# SEED_ON_START=demo
